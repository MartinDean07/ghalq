    <string name="toast_consent_denied">Ghalq needs VPN permission to block apps. Nothing is sent anywhere.</string>
    <string name="about_title">How Ghalq works</string>
    <string name="about_body">Ghalq starts a local VPN that only the apps you pick are routed into. It never forwards their traffic, so those apps lose internet while every other app uses your normal connection.</string>
    <string name="about_tips">Tips</string>
    <string name="tip_tile">Add the Ghalq tile to Quick Settings to switch blocking on or off in one tap.</string>
    <string name="tip_always_on">To keep blocking after a restart, turn on Always-on VPN for Ghalq in VPN settings.</string>
    <string name="tip_one_vpn">Android allows one VPN at a time. Starting another VPN switches Ghalq off.</string>
    <string name="open_vpn_settings">Open VPN settings</string>
    <string name="privacy_note">Private by design: Ghalq has no internet permission, no account, no analytics and no server. Your choices stay on this phone.</string>
    <string name="credit">Ghalq · designed and built by Martin Dean</string>
