    <string name="about_title">Slik fungerer Ghalq</string>
    <string name="about_body">Ghalq starter en lokal VPN som bare appene du velger, sendes gjennom. Trafikken deres sendes aldri videre, så disse appene mister internett, mens alle andre apper bruker den vanlige tilkoblingen.</string>
    <string name="about_tips">Tips</string>
    <string name="tip_tile">Legg Ghalq-flisen til i hurtiginnstillingene for å slå blokkeringen av og på med ett trykk.</string>
    <string name="tip_always_on">For at blokkeringen skal fortsette etter omstart, slår du på Alltid på-VPN for Ghalq i VPN-innstillingene.</string>
    <string name="tip_one_vpn">Android tillater én VPN om gangen. Starter du en annen VPN, slås Ghalq av.</string>
    <string name="open_vpn_settings">Åpne VPN-innstillinger</string>
    <string name="privacy_note">Personvern først: Ghalq har ingen internettillatelse, ingen konto, ingen analyse og ingen server. Valgene dine blir på telefonen.</string>
    <string name="credit">Ghalq · designet og utviklet av Martin Dean</string>
